# Firebase server configuration (never use NEXT_PUBLIC_ for credentials)
FIREBASE_PROJECT_ID=harrisonkim-dev
# Vercel uses short-lived OIDC credentials after the IAM binding is configured.
FIREBASE_WIF_PROVIDER=
FIREBASE_SERVICE_ACCOUNT_EMAIL=
# Local testing: start the Firestore emulator and use a demo project.
# FIREBASE_PROJECT_ID=demo-harrisonkim-dev
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ACCESS_TOKEN_SECRET=
ADMIN_PASSWORD=
